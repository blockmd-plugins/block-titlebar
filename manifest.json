{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-titlebar",
  "category": "appearance",
  "name": {
    "zh": "顶栏图标",
    "en": "Titlebar Icons"
  },
  "version": "1.0.1",
  "author": "Block Community",
  "repo": "blockmd-plugins/block-titlebar",
  "summary": {
    "zh": "像整理浏览器工具栏一样，收起右上角用不上的按钮，让顶栏更清爽",
    "en": "Declutter the top-right titlebar like a browser toolbar by hiding buttons you rarely use"
  },
  "entry": {
    "js": "main.js"
  },
  "permissions": [
    "storage",
    "ui:titlebar"
  ],
  "permission_reasons": {
    "storage": {
      "zh": "记住你隐藏了哪些顶栏按钮",
      "en": "Remember which titlebar buttons you chose to hide"
    },
    "ui:titlebar": {
      "zh": "读取右上角按钮列表并按你的开关显示或隐藏它们",
      "en": "Read the top-right buttons and show or hide them per your settings"
    }
  },
  "surfaces": [
    "settings_page"
  ],
  "contributes": {
    "titlebar_manager": true
  },
  "icon": {
    "view_box": "0 0 24 24",
    "fill_paths": [
      "M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4H4V6Z"
    ],
    "stroke_paths": [
      "M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z",
      "M4 10h16",
      "M7.5 14h6",
      "M7.5 17h4"
    ],
    "accent_paths": [
      "M11 7m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0",
      "M14 7m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0",
      "M17 7m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"
    ]
  }
}
